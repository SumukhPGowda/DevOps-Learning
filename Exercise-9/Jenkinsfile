pipeline {
    agent any

    environment {
        APP_DIR = 'Exercise-9'
        DEPLOY_DIR = 'python-app-deploy'
        VENV_DIR = '.venv'
    }

    stages {
        stage('Build') {
            steps {
                echo 'Preparing Python application and dependencies...'
                sh 'python3 --version'
                sh 'python3 -m venv "${VENV_DIR}"'
                sh '"${VENV_DIR}/bin/pip" install -r "${APP_DIR}/requirements.txt"'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh '"${VENV_DIR}/bin/python" -m unittest discover -s "${APP_DIR}"'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${DEPLOY_DIR}"
                    cp "${APP_DIR}/app.py" "${DEPLOY_DIR}/"
                    cp "${APP_DIR}/requirements.txt" "${DEPLOY_DIR}/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "${DEPLOY_DIR}/app.pid" ]; then
                        kill "$(cat "${DEPLOY_DIR}/app.pid")" 2>/dev/null || true
                    fi

                    nohup "${WORKSPACE}/${VENV_DIR}/bin/python" \
                        "${WORKSPACE}/${DEPLOY_DIR}/app.py" \
                        > "${WORKSPACE}/${DEPLOY_DIR}/app.log" 2>&1 &

                    echo $! > "${DEPLOY_DIR}/app.pid"
                    sleep 3
                    kill -0 "$(cat "${DEPLOY_DIR}/app.pid")"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Testing deployed Flask application...'
                sh '''
                    "${VENV_DIR}/bin/python" -c "
import time
import urllib.request

url = 'http://127.0.0.1:5000/'
for attempt in range(10):
    try:
        with urllib.request.urlopen(url, timeout=3) as response:
            body = response.read().decode()
            assert response.status == 200, response.status
            assert body == 'Hello, Jenkins Multi-Stage Pipeline!', body
            print('HTTP status:', response.status)
            print('Response:', body)
            break
    except Exception:
        if attempt == 9:
            raise
        time.sleep(1)
"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
    }
}
