pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                echo 'Preparing Python application and dependencies...'
                sh 'python3 --version'
                sh 'python3 -m pip --version'
                sh 'python3 -m pip install --user -r requirements.txt'
            }
        }

        stage('Test') {
            steps {
                echo 'Running unit tests...'
                sh 'python3 -m unittest discover -s .'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "${WORKSPACE}/python-app-deploy"
                    cp app.py requirements.txt "${WORKSPACE}/python-app-deploy/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting Flask application...'
                sh '''
                    if [ -f "${WORKSPACE}/python-app-deploy/app.pid" ]; then
                        kill "$(cat "${WORKSPACE}/python-app-deploy/app.pid")" 2>/dev/null || true
                    fi
                    nohup python3 "${WORKSPACE}/python-app-deploy/app.py" \
                        > "${WORKSPACE}/python-app-deploy/app.log" 2>&1 &
                    echo $! > "${WORKSPACE}/python-app-deploy/app.pid"
                    sleep 3
                    kill -0 "$(cat "${WORKSPACE}/python-app-deploy/app.pid")"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Verifying application response...'
                sh 'python3 -m unittest discover -s .'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
    }
}
